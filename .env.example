# Backend runtime
APP_ENV=local
DATABASE_URL=postgres://agro_ops:agro_ops@postgres:5432/agro_ops
PORT=8080
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
JOB_POLL_INTERVAL_MILLISECONDS=1000
JOB_CLAIM_BATCH_SIZE=10
JOB_STALE_THRESHOLD_SECONDS=300

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key
# Backend API only. Never expose this value through NEXT_PUBLIC_* or Vercel.
SUPABASE_SECRET_KEY=sb_secret_your_backend_only_key
SUPABASE_INVITE_REDIRECT_URL=http://localhost:3000/aceptar-invitacion
# Must already exist and remain private. The backend service key is never exposed.
SUPABASE_STORAGE_BUCKET=documentos_privados
DOCUMENT_MAX_UPLOAD_BYTES=10485760

# Web runtime
API_BASE_URL=http://api:8080
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key

# Logging
RUST_LOG=info
